/*
 * Point the FETCH_DATABASES process at a locally-built image that has sourcerer
 * installed. The dotted first component (local.registry) stops Nextflow prepending
 * its default registry, so the local image is used as-is; the workflow tags the
 * built image to match.
 */
process {
    withName: 'FETCH_DATABASES' {
        container = 'local.registry/airrflow-sourcerer:test'
    }
}

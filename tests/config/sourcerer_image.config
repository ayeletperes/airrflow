/*
 * Point the germline reference processes at an image that has sourcerer.
 *
 * Pinned to the sourcerer commit it was built from, since sourcerer is not
 * released yet. Drop this file once sourcerer ships in the default airrflow
 * image and FETCH_DATABASES can declare it directly.
 */
process {
    withName: 'FETCH_DATABASES' {
        container = 'peresay/airrflow-sourcerer:sourcerer-8804973'
    }

    withName: 'MAKE_IGBLAST_AUX' {
        container = 'peresay/airrflow-sourcerer:sourcerer-8804973'
    }
}

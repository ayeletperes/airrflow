/*
 * Two samples of the same run restricted to different loci (IGH and IGK), to
 * check that one restricted reference is built per distinct locus and that each
 * sample is routed to its own.
 *
 *   nextflow run nf-core/airrflow -profile test_locus_restriction,<docker/singularity>
 */
process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test per-sample locus restriction'
    config_profile_description = 'Two samples restricted to IGH and IGK respectively, to exercise per-locus reference building and routing'

    mode = 'assembled'
    input = '/mnt/data/airrflow-dev/test_locus_restriction_metadata.tsv'
    reference_fasta = params.pipelines_testdata_base_path + 'database-cache/imgtdb_base.zip'
    reference_igblast = params.pipelines_testdata_base_path + 'database-cache/igblast_base.zip'

    skip_report = true
    skip_clonal_analysis = true
}

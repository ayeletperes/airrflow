/*
 * Synthetic R24 macaque-style dataset for the 'dt_5p_ts_header' library generation
 * method: reads already demultiplexed and trimmed, UMI= / TRIM= annotations in the R1 header.
 *
 * Three samples of 200 pairs each (150 assemble + quality pass, 30 assemble but fail
 * FilterSeq, 20 fail assembly). S3 is left uncompressed to exercise the mixed
 * gzipped / plain input of the real data. Regenerate with tests/rm/make_test_data.py.
 *
 *   nextflow run . -profile test_rm,<docker/singularity> --outdir <OUTDIR>
 *
 * ponytail: the samplesheet holds repository-relative read paths, so the profile must be
 * launched from a checkout root. Move the fixtures to nf-core/test-datasets and switch to
 * pipelines_testdata_base_path when they are published.
 */
process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile for reads with the UMI in the header'
    config_profile_description = 'Synthetic pre-demultiplexed, pre-trimmed dataset to check the dt_5p_ts_header protocol'

    mode = 'fastq'
    library_generation_method = 'dt_5p_ts_header'

    input = 'tests/rm/samplesheet.tsv'
    reference_fasta = params.pipelines_testdata_base_path + 'database-cache/imgtdb_base.zip'
    reference_igblast = params.pipelines_testdata_base_path + 'database-cache/igblast_base.zip'

    // ponytail: the synthetic reads are random sequence, so IgBLAST annotates nothing and
    // CHANGEO_MAKEDB fails. The profile therefore exercises pre-processing only. Drop this
    // once the fixtures carry real macaque V(D)J sequence.
    skip_vdj_annotation = true

    skip_clonal_analysis = true
}

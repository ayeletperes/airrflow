/*
 * One subject with a personal germline set and one without, in the same run.
 * The mixed path is what regresses: a run where every subject has a personal set
 * and a run where none does both exercise a single lane.
 *
 * Needs a container with receptor_utils, so -profile conda is not supported.
 *
 *   nextflow run nf-core/airrflow -profile test_ggs,<docker/singularity>
 */
process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test per-subject germline sets (zipped)'
    config_profile_description = 'One subject with a personal germline set and one without, supplied as a zip archive'

    mode = 'assembled'
    // ponytail: lab-local until the fixtures are in test-datasets
    input = '/mnt/data/airrflow-dev/ggs_metadata.tsv'
    ggs_input = '/mnt/data/airrflow-dev/ggs_input_zip.tsv'
    reference_fasta = params.pipelines_testdata_base_path + 'database-cache/imgtdb_base.zip'
    reference_igblast = params.pipelines_testdata_base_path + 'database-cache/igblast_base.zip'

    generate_igblast_aux = true

    skip_report = true
    skip_clonal_analysis = true
}
